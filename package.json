{
  "name": "socketto",
  "version": "2.0.1",
  "description": "Tiny wrapper for WebSocket Web API",
  "keywords": [
    "RFC-6455",
    "client",
    "real-time",
    "reconnect",
    "socket",
    "tcp",
    "web",
    "websocket",
    "websockets"
  ],
  "homepage": "https://github.com/karsanda/socketto#readme",
  "bugs": {
    "url": "https://github.com/karsanda/socketto/issues"
  },
  "license": "MIT",
  "author": "Pinto Karsanda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karsanda/socketto.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "vitest-websocket-mock": "^0.8.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.6.0"
}
